{
  "name": "moosik-listen-along",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "routes": [{ "pattern": "rooms.moosik.dev", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [{ "name": "CREATIONS", "namespace_id": "60261", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } }
}
