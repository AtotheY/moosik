1 ICON "../../assets/icons/app/refryt.ico"

// Filled in by build.rs from Cargo's version.
1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "refryt"
            VALUE "FileDescription", "refryt"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "refryt"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "refryt.exe"
            VALUE "ProductName", "refryt"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
